generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["marketing"]
}

enum MarketingCrmSettingCategory {
  PRODUCT
  DECISION_MAKER
  SOURCE_TYPE
  INTERACTION_MEDIUM
  PROSPECT_BUSINESS_TYPE

  @@schema("marketing")
}

enum MarketingProspectFollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED

  @@schema("marketing")
}

/// Where a billing transaction raised for a client stands in Accounting. Accounting owns the
/// real state; this mirrors only what marketing needs to act on (product status).
enum MarketingClientBillingState {
  SUBMITTED
  POSTED
  REVERSED
  REJECTED

  @@schema("marketing")
}

enum MarketingClientProductStatus {
  PENDING
  PURCHASED
  UNINTERESTED

  @@schema("marketing")
}

enum MarketingCampaignChannel {
  SMS
  EMAIL

  @@schema("marketing")
}

enum MarketingCampaignDispatchMode {
  INSTANT
  SCHEDULED

  @@schema("marketing")
}

enum MarketingCampaignStatus {
  DRAFT
  PENDING_DISPATCH
  SCHEDULED
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED

  @@schema("marketing")
}

enum MarketingCampaignRecipientStatus {
  PENDING
  QUEUED
  SENDING
  ACCEPTED
  DELIVERED
  SENT
  FAILED
  SKIPPED
  CANCELLED

  @@schema("marketing")
}

enum MarketingSmsSenderIdentityStatus {
  DRAFT
  PENDING_PROVIDER_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED

  @@schema("marketing")
}

enum MarketingSmsCreditLedgerEntryType {
  INITIAL_ALLOCATION
  PLAN_ALLOCATION
  PURCHASE
  ADMIN_GRANT
  PROMOTIONAL
  CAMPAIGN_RESERVATION
  CAMPAIGN_CONSUMPTION
  CAMPAIGN_RELEASE
  CAMPAIGN_REFUND
  ADMIN_ADJUSTMENT

  @@schema("marketing")
}

enum MarketingSmsCreditReservationStatus {
  ACTIVE
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
  EXPIRED

  @@schema("marketing")
}

enum MarketingTransportRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED

  @@schema("marketing")
}

enum MarketingAppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED

  @@schema("marketing")
}

enum MarketingFleetVehicleType {
  SEDAN
  SUV
  PICKUP
  VAN
  MINIBUS
  BUS
  MOTORCYCLE
  TRUCK
  OTHER

  @@schema("marketing")
}

enum MarketingFleetFuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  OTHER

  @@schema("marketing")
}

model MarketingCrmSettingOption {
  id              String                      @id @default(uuid())
  tenantId        String
  category        MarketingCrmSettingCategory
  name            String
  normalizedName  String
  description     String?
  displayOrder    Int                         @default(0)
  isActive        Boolean                     @default(true)
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([tenantId, category, isActive])
  @@index([tenantId, category, displayOrder])
  @@index([tenantId, category, archivedAt])
  @@index([tenantId, category, normalizedName])
  @@schema("marketing")
}

model MarketingPipelineStage {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  normalizedName  String
  probability     Int
  description     String?
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, isActive])
  @@index([tenantId, displayOrder])
  @@index([tenantId, archivedAt])
  @@index([tenantId, normalizedName])
  @@schema("marketing")
}

model MarketingProspect {
  id                    String   @id @default(uuid())
  tenantId              String
  companyName           String
  normalizedCompanyName String
  businessTypeId        String?
  sourceTypeId          String?
  pipelineStageId       String
  assignedUserId        String
  locationLabel         String
  latitude              Decimal  @db.Decimal(9, 6)
  longitude             Decimal  @db.Decimal(9, 6)
  createdByUserId       String?
  updatedByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contacts     MarketingProspectContact[]
  products     MarketingProspectProduct[]
  interactions MarketingProspectInteraction[]
  followUps    MarketingProspectFollowUp[]
  appointments MarketingAppointment[]
  client       MarketingClient?

  @@index([tenantId, normalizedCompanyName])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, pipelineStageId])
  @@index([tenantId, createdAt])
  @@schema("marketing")
}

model MarketingProspectContact {
  id                  String   @id @default(uuid())
  tenantId            String
  prospectId          String
  name                String
  phone               String?
  email               String?
  decisionMakerTypeId String?
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  prospect MarketingProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([tenantId, prospectId])
  @@index([tenantId, decisionMakerTypeId])
  @@schema("marketing")
}

model MarketingProspectProduct {
  id                String    @id @default(uuid())
  tenantId          String
  prospectId        String
  productId         String
  expectedValue     Decimal   @db.Decimal(18, 2)
  achievedValue     Decimal?  @db.Decimal(18, 2)
  commissionRate    Decimal?  @db.Decimal(7, 4)
  commissionAmount  Decimal?  @db.Decimal(18, 2)
  expectedCloseDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  prospect MarketingProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([tenantId, prospectId])
  @@index([tenantId, productId])
  @@index([tenantId, expectedCloseDate])
  @@schema("marketing")
}

model MarketingProspectInteraction {
  id                    String   @id @default(uuid())
  tenantId              String
  prospectId            String?
  clientId              String?
  interactionMediumId   String?
  occurredAt            DateTime
  notes                 String?
  decisionMakerInvolved Boolean  @default(false)
  createdByUserId       String?
  createdAt             DateTime @default(now())

  prospect     MarketingProspect?                        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client       MarketingClient?                          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  participants MarketingProspectInteractionParticipant[]

  @@index([tenantId, prospectId, occurredAt])
  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, interactionMediumId])
  @@schema("marketing")
}

model MarketingProspectInteractionParticipant {
  id            String   @id @default(uuid())
  tenantId      String
  interactionId String
  fullName      String
  phone         String
  role          String
  createdAt     DateTime @default(now())

  interaction MarketingProspectInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([tenantId, interactionId])
  @@schema("marketing")
}

model MarketingProspectFollowUp {
  id                     String                          @id @default(uuid())
  tenantId               String
  prospectId             String?
  clientId               String?
  dueAt                  DateTime
  note                   String?
  status                 MarketingProspectFollowUpStatus @default(PENDING)
  createdByUserId        String?
  completedByUserId      String?
  completedAt            DateTime?
  completedInteractionId String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  prospect MarketingProspect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client   MarketingClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, prospectId])
  @@index([tenantId, prospectId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, status])
  @@schema("marketing")
}

model MarketingClient {
  id                      String    @id @default(uuid())
  tenantId                String
  companyName             String
  normalizedCompanyName   String
  businessTypeId          String?
  sourceTypeId            String?
  assignedUserId          String
  locationLabel           String
  latitude                Decimal   @db.Decimal(9, 6)
  longitude               Decimal   @db.Decimal(9, 6)
  isBillable              Boolean   @default(false)
  /// The client's entity in Accounting, created with its first billing transaction. One per client.
  accountingEntityId      String?
  /// The entity type Accounting created that entity under - fixed after the first transaction.
  accountingEntityTypeId  String?
  convertedFromProspectId String?   @unique
  convertedAt             DateTime?
  convertedByUserId       String?
  createdByUserId         String?
  updatedByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  convertedFromProspect MarketingProspect?             @relation(fields: [convertedFromProspectId], references: [id], onDelete: SetNull)
  contacts              MarketingClientContact[]
  products              MarketingClientProduct[]
  billings              MarketingClientBilling[]
  interactions          MarketingProspectInteraction[]
  followUps             MarketingProspectFollowUp[]

  @@index([tenantId, normalizedCompanyName])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@schema("marketing")
}

model MarketingClientContact {
  id                  String   @id @default(uuid())
  tenantId            String
  clientId            String
  name                String
  phone               String?
  email               String?
  decisionMakerTypeId String?
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client MarketingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([tenantId, decisionMakerTypeId])
  @@schema("marketing")
}

model MarketingClientProduct {
  id               String                       @id @default(uuid())
  tenantId         String
  clientId         String
  productId        String
  status           MarketingClientProductStatus @default(PENDING)
  /// Carried over from the prospect product at conversion; null for products added directly.
  expectedValue    Decimal?                     @db.Decimal(18, 2)
  commissionRate   Decimal?                     @db.Decimal(7, 4)
  commissionAmount Decimal?                     @db.Decimal(18, 2)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  client MarketingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([tenantId, clientId])
  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@schema("marketing")
}

/// Fleet-specific details for a vehicle. The vehicle itself is an HR Asset
/// (type VEHICLE) that this row points at by assetId; identity, branch, driver
/// and status stay in hr-service so both modules share one record.
model MarketingFleetVehicle {
  id                 String                    @id @default(uuid())
  tenantId           String
  assetId            String
  vehicleType        MarketingFleetVehicleType
  make               String
  model              String
  yearOfRegistration Int
  fuelType           MarketingFleetFuelType
  currentMileage     Int?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([tenantId, assetId])
  @@index([tenantId, vehicleType])
  @@index([tenantId, fuelType])
  @@schema("marketing")
}

/// A staff transport request. Requester, department and passenger names are
/// snapshots taken at submission so the record stays accurate if HR data changes.
model MarketingTransportRequest {
  id                    String                          @id @default(uuid())
  tenantId              String
  requesterUserId       String
  requesterEmployeeId   String?
  requesterName         String
  requesterDepartment   String?
  businessPurpose       String
  travelDate            DateTime                        @db.Date
  departureTime         String
  returnTime            String
  destination           String
  notes                 String?
  status                MarketingTransportRequestStatus @default(PENDING)
  reviewedByUserId      String?
  reviewedByName        String?
  reviewedAt            DateTime?
  reviewNote            String?
  /// Set on approval. Names are snapshots; the vehicle is an HR asset id and the
  /// driver an HR employee id. Allocating does not change HR assignment or status.
  vehicleAssetId        String?
  vehicleName           String?
  vehicleAssetNumber    String?
  driverEmployeeId      String?
  driverName            String?
  /// True when the requester drives; driverEmployeeId/driverName then hold the requester.
  selfDriven            Boolean                         @default(false)
  /// Set when someone completes the trip (a trip never completes on its own).
  completedAt           DateTime?
  completedByUserId     String?
  completedByName       String?
  /// Actual return, HH:mm on the travel date, to compare with returnTime.
  actualReturnTime      String?
  /// Set when an approver reschedules; the previous schedule is kept for display.
  rescheduleCount       Int                             @default(0)
  rescheduledAt         DateTime?
  rescheduledByName     String?
  previousTravelDate    DateTime?                       @db.Date
  previousDepartureTime String?
  previousReturnTime    String?
  cancelledAt           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  passengers MarketingTransportRequestPassenger[]

  @@index([tenantId, status, travelDate])
  @@index([tenantId, requesterUserId, createdAt], map: "MarketingTransportRequest_requester_created_idx")
  @@index([tenantId, createdAt])
  @@index([tenantId, vehicleAssetId, travelDate], map: "MarketingTransportRequest_vehicle_date_idx")
  @@index([tenantId, driverEmployeeId, travelDate], map: "MarketingTransportRequest_driver_date_idx")
  @@schema("marketing")
}

model MarketingTransportRequestPassenger {
  id         String   @id @default(uuid())
  tenantId   String
  requestId  String
  employeeId String
  name       String
  department String?
  createdAt  DateTime @default(now())

  request MarketingTransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, employeeId])
  @@index([tenantId, employeeId])
  @@schema("marketing")
}

/// A driver: an HR employee marked as a transport officer. HR owns the person;
/// this row only records that they drive. `name` is a fallback label for when
/// the employee is no longer active in HR.
/// A meeting a marketer books with a prospect. Anyone can book for themselves; holders of
/// marketing.appointments.all:CREATE can book for other marketers. An approver confirms it and may
/// assign a manager. Names are snapshots so the history reads correctly after renames or removals.
model MarketingAppointment {
  id               String                     @id @default(uuid())
  tenantId         String
  prospectId       String?
  prospectName     String
  date             DateTime                   @db.Date
  startTime        String
  endTime          String?
  /// The marketer the appointment is for (who requested it, or on whose behalf it was booked).
  marketerUserId   String
  marketerName     String
  managerUserId    String?
  managerName      String?
  comment          String?
  status           MarketingAppointmentStatus @default(PENDING)
  createdByUserId  String
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?
  reviewNote       String?
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  prospect MarketingProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, date])
  @@index([tenantId, marketerUserId, date], map: "MarketingAppointment_marketer_date_idx")
  @@index([tenantId, managerUserId, date], map: "MarketingAppointment_manager_date_idx")
  @@index([tenantId, prospectId])
  @@schema("marketing")
}

model MarketingTransportOfficer {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  name            String
  isActive        Boolean   @default(true)
  deactivatedAt   DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, employeeId])
  @@index([tenantId, isActive])
  @@schema("marketing")
}

model MarketingCampaign {
  id                String                        @id @default(uuid())
  tenantId          String
  name              String
  channels          MarketingCampaignChannel[]
  businessTypeIds   String[]
  businessTypeNames String[]
  senderIdentityId  String?
  senderIdSnapshot  String?
  subject           String
  message           String
  dispatchMode      MarketingCampaignDispatchMode
  scheduledDate     DateTime?                     @db.Date
  status            MarketingCampaignStatus
  estimatedCredits  Int?
  smsReservationId  String?
  reservedCredits   Int                           @default(0)
  consumedCredits   Int                           @default(0)
  dispatchedAt      DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  createdByUserId   String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  recipients MarketingCampaignRecipient[]
  sender     MarketingSmsSenderIdentity?  @relation(fields: [senderIdentityId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, senderIdentityId])
  @@schema("marketing")
}

/// One row per prospect primary contact per channel, fixed when the campaign is created.
model MarketingCampaignRecipient {
  id               String                           @id @default(uuid())
  tenantId         String
  campaignId       String
  prospectId       String
  contactId        String
  companyName      String
  contactName      String
  channel          MarketingCampaignChannel
  /// Phone or email at creation time; null when the contact has none (row is SKIPPED).
  address          String?
  status           MarketingCampaignRecipientStatus @default(PENDING)
  segmentCount     Int?
  estimatedCredits Int?
  senderIdSnapshot String?
  senderIdentityId String?
  smsReservationId String?
  provider         String?
  providerMessageId String?
  attemptCount     Int                              @default(0)
  lastAttemptAt    DateTime?
  acceptedAt       DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureCode      String?
  failureReason    String?
  creditConsumedAt DateTime?
  creditReleasedAt DateTime?
  providerDetail   String?
  sentAt           DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  campaign MarketingCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   MarketingSmsSenderIdentity? @relation(fields: [senderIdentityId], references: [id], onDelete: Restrict)

  @@unique([campaignId, contactId, channel])
  @@index([tenantId, campaignId, status])
  @@index([tenantId, senderIdentityId])
  @@schema("marketing")
}

model MarketingSmsSenderIdentity {
  id                 String                           @id @default(uuid())
  tenantId           String
  senderId           String
  normalizedSenderId String
  displayName        String?
  provider           String?
  providerReference  String?
  status             MarketingSmsSenderIdentityStatus @default(DRAFT)
  isDefault          Boolean                          @default(false)
  requestedBy        String?
  requestedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdBy          String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  campaigns  MarketingCampaign[]
  recipients MarketingCampaignRecipient[]

  @@unique([tenantId, normalizedSenderId])
  @@index([tenantId, status])
  @@index([tenantId, isDefault])
  @@schema("marketing")
}

model MarketingSmsWallet {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  availableCredits Int      @default(0)
  reservedCredits  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ledgerEntries MarketingSmsCreditLedgerEntry[]
  reservations  MarketingSmsCreditReservation[]

  @@schema("marketing")
}

model MarketingSmsCreditLedgerEntry {
  id              String                            @id @default(uuid())
  tenantId        String
  walletId        String
  type            MarketingSmsCreditLedgerEntryType
  credits         Int
  availableBefore Int
  availableAfter  Int
  reservedBefore  Int
  reservedAfter   Int
  campaignId      String?
  recipientId     String?
  reservationId   String?
  idempotencyKey  String?
  reason          String?
  metadata        Json?
  createdBy       String?
  createdAt       DateTime                          @default(now())

  wallet MarketingSmsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, walletId, createdAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, reservationId])
  @@schema("marketing")
}

model MarketingSmsCreditReservation {
  id              String                              @id @default(uuid())
  tenantId        String
  walletId        String
  campaignId      String?
  status          MarketingSmsCreditReservationStatus @default(ACTIVE)
  reservedCredits Int
  consumedCredits Int                                 @default(0)
  releasedCredits Int                                 @default(0)
  idempotencyKey  String
  expiresAt       DateTime?
  createdAt       DateTime                            @default(now())
  updatedAt       DateTime                            @updatedAt

  wallet MarketingSmsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, walletId, status])
  @@index([tenantId, campaignId])
  @@schema("marketing")
}

/// A transaction raised in Accounting for a client. Accounting never learns which product it was
/// for - that link lives only here, and drives the product's Purchased status once the
/// transaction is posted (and back to Pending if it is reversed).
model MarketingClientBilling {
  id                      String                      @id @default(uuid())
  tenantId                String
  clientId                String
  /// CRM Settings product the transaction was raised for, when one was picked.
  productId               String?
  accountingTransactionId String
  idempotencyKey          String
  state                   MarketingClientBillingState @default(SUBMITTED)
  amount                  Decimal                     @db.Decimal(20, 2)
  createdByUserId         String
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  client MarketingClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([tenantId, accountingTransactionId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, clientId])
  @@index([tenantId, clientId, productId, state])
  @@schema("marketing")
}
