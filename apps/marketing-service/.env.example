# Fleet module: vehicles are HR assets, so marketing-service calls hr-service's internal
# /internal/fleet-assets routes. INTERNAL_SERVICE_AUTH_SECRET (32+ chars) must match hr-service,
# and hr-service must list "marketing-service" in INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES.
HR_SERVICE_URL=http://localhost:4002
HR_SERVICE_TIMEOUT_MS=10000
INTERNAL_SERVICE_AUTH_SECRET=

# Appointments: marketing-service asks auth-service (internal /internal/tenants/:id/module-users)
# who has marketing access, to fill and validate the marketer and manager pickers. auth-service
# must list "marketing-service" in its INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES.
AUTH_SERVICE_URL=http://localhost:4001
AUTH_SERVICE_TIMEOUT_MS=10000

# In-app notifications: new appointments notify the people who can approve them (and decisions notify
# the marketer) through the notification service. Optional - without it appointments still work and
# notifications are skipped with a warning.
RABBITMQ_URL=amqps://user:password@shark.rmq.cloudamqp.com/vhost

# Client billing: marketing tells accounting-service about a client's transaction, and
# accounting-service calls back (POST /internal/accounting-events) when it is posted, reversed or
# rejected. accounting-service must list "marketing-service" in its
# INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES, and this service must list "accounting-service" in its own.
ACCOUNTING_SERVICE_URL=http://localhost:4008
ACCOUNTING_SERVICE_TIMEOUT_MS=10000
INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES=accounting-service

# Timezone trip times are read in, to decide when a booked trip becomes "on route" and when it ends.
# Defaults to Africa/Accra (UTC+0, no daylight saving). There is no per-tenant timezone yet.
# TRANSPORT_TIMEZONE=Africa/Accra
