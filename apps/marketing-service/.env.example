# Fleet module: vehicles are HR assets, so marketing-service calls hr-service's internal
# /internal/fleet-assets routes. INTERNAL_SERVICE_AUTH_SECRET (32+ chars) must match hr-service,
# and hr-service must list "marketing-service" in INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES.
HR_SERVICE_URL=http://localhost:4002
HR_SERVICE_TIMEOUT_MS=10000
INTERNAL_SERVICE_AUTH_SECRET=
