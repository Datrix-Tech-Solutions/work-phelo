{
  "name": "subscription-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "echo \"No Prisma models to generate for subscription-service\""
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/microservices": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.1",
    "@prisma/client": "^5.18.0",
    "@sentry/nestjs": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "@work-phelo/config": "file:../../packages/config",
    "@work-phelo/schemas": "file:../../packages/schemas",
    "@work-phelo/types": "file:../../packages/types",
    "@work-phelo/utils": "file:../../packages/utils",
    "amqplib": "^0.10.4",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "14.5.0",
    "ioredis": "^5.4.1",
    "multer": "2.4.0",
    "nest-winston": "^1.9.7",
    "nodemailer": "10.0.12",
    "paystack": "^2.0.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "winston": "^3.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.40",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "passWithNoTests": true
  }
}
