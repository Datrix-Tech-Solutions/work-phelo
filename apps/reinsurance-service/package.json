{
  "name": "reinsurance-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "precheck-types": "npm run db:generate",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "start": "node dist/main",
    "prelint": "npm run db:generate",
    "lint": "eslint \"src/**/*.ts\"",
    "pretest": "npm run db:generate",
    "test": "jest",
    "pretest:unit": "npm run db:generate",
    "test:unit": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@golevelup/nestjs-rabbitmq": "9.0.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/microservices": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.1",
    "@prisma/client": "^5.22.0",
    "@sentry/nestjs": "11.0.0",
    "@sentry/node": "11.0.0",
    "@work-phelo/types": "file:../../packages/types",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "14.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.4.0",
    "nodemailer": "10.0.12",
    "pg": "^8.13.1",
    "playwright-core": "^1.60.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.40",
    "@types/pg": "^8.11.10",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "passWithNoTests": true
  }
}
