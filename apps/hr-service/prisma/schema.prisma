generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["hr"]
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN

  @@schema("hr")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  OFFBOARDED

  @@schema("hr")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@schema("hr")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED

  @@schema("hr")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("hr")
}

enum TimeCorrectionStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("hr")
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID

  @@schema("hr")
}

enum AppraisalStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("hr")
}

enum AppraisalCycleStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("hr")
}

enum AppraisalCycleRecipientGroup {
  ALL
  PERMANENT
  CONTRACTUAL
  PROBATION
  INTERNS

  @@schema("hr")
}

enum AppraisalReminderType {
  SELF_7_DAYS
  SELF_3_DAYS
  SELF_DUE
  MANAGER_7_DAYS
  MANAGER_3_DAYS
  MANAGER_DUE

  @@schema("hr")
}

enum ReviewStatus {
  PENDING
  SUBMITTED

  @@schema("hr")
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FLEXIBLE

  @@schema("hr")
}

enum ShiftSwapStatus {
  PENDING_COLLEAGUE
  PENDING_MANAGER
  APPROVED
  DECLINED
  REJECTED
  EXPIRED
  CANCELLED

  @@schema("hr")
}

enum ShiftSwapActionType {
  REQUESTED
  COLLEAGUE_ACCEPTED
  COLLEAGUE_DECLINED
  MANAGER_APPROVED
  MANAGER_REJECTED
  EXPIRED

  @@schema("hr")
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID

  @@schema("hr")
}

enum DocumentType {
  CONTRACT
  ID_CARD
  PASSPORT
  CERTIFICATE
  OFFER_LETTER
  NDA
  OTHER

  @@schema("hr")
}

enum AllowanceType {
  TRANSPORT
  HOUSING
  MEDICAL
  OTHER

  @@schema("hr")
}

enum AssetType {
  LAPTOP
  PHONE
  TABLET
  PRINTER
  MONITOR
  VEHICLE
  FURNITURE
  SOFTWARE_LICENSE
  OTHER

  @@schema("hr")
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED

  @@schema("hr")
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR

  @@schema("hr")
}

enum CompanyAgreementType {
  NDA
  EMPLOYMENT_CONTRACT
  CONFIDENTIALITY
  NON_COMPETE
  CODE_OF_CONDUCT
  IP_ASSIGNMENT
  PROBATION_AGREEMENT
  OTHER

  @@schema("hr")
}

enum AnnouncementAudienceType {
  ALL
  DEPARTMENTS
  BRANCHES
  EMPLOYEES

  @@schema("hr")
}

// ── Branch ───────────────────────────────────────────────────────────────

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String?
  address     String?
  city        String?
  region      String?
  country     String?
  phone       String?
  email       String?
  managerId   String?
  isActive    Boolean  @default(true)
  isHeadOffice Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]

  @@unique([tenantId, name])
  @@schema("hr")
}

// ── Department ────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  managerId   String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]

  @@unique([tenantId, name])
  @@schema("hr")
}

// ── Employee ──────────────────────────────────────────────────────────────

model Employee {
  id                String           @id @default(uuid())
  tenantId          String
  userId            String?          @unique
  employeeNumber    String
  firstName         String
  lastName          String
  email             String
  phone             String?
  gender            Gender?
  dateOfBirth       DateTime?
  maritalStatus     MaritalStatus?
  nationality       String?
  address           String?
  city              String?
  region            String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  departmentId      String?
  branchId          String?
  managerId         String?
  jobTitle          String
  employmentType    EmploymentType   @default(FULL_TIME)
  employmentStatus      EmploymentStatus @default(PROBATION)
  statusChangedAt       DateTime?
  statusChangedById     String?
  statusChangedByEmail  String?
  hireDate          DateTime
  probationEndsAt   DateTime?
  contractEndDate   DateTime?
  offboardedAt      DateTime?
  offboardReason    String?
  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  nationalId        String?
  ssnit             String?
  tinNumber         String?
  basicSalary       Decimal          @db.Decimal(15, 2)
  avatarUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  department        Department?       @relation(fields: [departmentId], references: [id])
  branch            Branch?           @relation(fields: [branchId], references: [id])
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  clockRecords      ClockRecord[]
  timesheets        Timesheet[]
  timeCorrections   TimeCorrection[]
  schedules         ShiftSchedule[]
  requestedShiftSwaps ShiftSwapRequest[] @relation("ShiftSwapRequester")
  targetShiftSwaps    ShiftSwapRequest[] @relation("ShiftSwapTarget")
  managedShiftSwaps   ShiftSwapRequest[] @relation("ShiftSwapManager")
  shiftSwapActionLogs ShiftSwapActionLog[]
  shiftOverrides      ShiftAssignmentOverride[]
  payrollItems      PayrollItem[]
  appraisals        Appraisal[]       @relation("AppraisalEmployee")
  managedAppraisals Appraisal[]       @relation("AppraisalManager")
  documents         EmployeeDocument[]
  allowances        EmployeeAllowance[]
  assignedAssets    Asset[]           @relation("AssignedAssets")
  assetAssignments  AssetAssignment[] @relation("EmployeeAssetAssignments")
  offboarding       OffboardingRecord?
  resignation       ResignationRecord?

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@schema("hr")
}

// ── Assets ────────────────────────────────────────────────────────────────

model Asset {
  id                 String          @id @default(uuid())
  tenantId           String
  assetNumber        String
  name               String
  type               AssetType
  serialNumber       String?
  purchaseDate       DateTime?
  purchaseCost       Decimal?        @db.Decimal(15, 2)
  currency           String?
  condition          AssetCondition?
  notes              String?
  status             AssetStatus     @default(AVAILABLE)
  assignedEmployeeId String?
  assignedAt         DateTime?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignedEmployee   Employee?        @relation("AssignedAssets", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignments        AssetAssignment[]

  @@unique([tenantId, assetNumber])
  @@index([tenantId, status])
  @@index([tenantId, assignedEmployeeId])
  @@schema("hr")
}

model AssetAssignment {
  id         String   @id @default(uuid())
  tenantId   String
  assetId    String
  employeeId String
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  createdAt  DateTime @default(now())

  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee @relation("EmployeeAssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, returnedAt])
  @@index([tenantId, assetId, returnedAt])
  @@schema("hr")
}

// ── Offboarding Record ────────────────────────────────────────────────────────

enum OffboardReason {
  RESIGNATION
  TERMINATION
  CONTRACT_ENDED
  RETIREMENT
  REDUNDANCY
  OTHER

  @@schema("hr")
}

enum ResignationReason {
  PERSONAL_REASONS
  BETTER_OPPORTUNITY
  RELOCATION
  FURTHER_EDUCATION
  HEALTH_REASONS
  OTHER

  @@schema("hr")
}

enum ResignationStatus {
  PENDING
  DISMISSED
  WITHDRAWN
  OFFBOARDING_INITIATED

  @@schema("hr")
}

model ResignationRecord {
  id                     String             @id @default(uuid())
  tenantId               String
  employeeId             String             @unique
  lastWorkingDate        DateTime
  reason                 ResignationReason?
  additionalNotes        String?
  status                 ResignationStatus  @default(PENDING)
  submittedAt            DateTime           @default(now())
  withdrawnAt            DateTime?
  dismissedAt            DateTime?
  dismissedById          String?
  dismissedByEmail       String?
  offboardingInitiatedAt DateTime?
  offboardingRecordId    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

model OffboardingRecord {
  id            String          @id @default(uuid())
  tenantId      String
  employeeId    String          @unique
  reason        OffboardReason
  otherReason   String?
  lastWorkingDate DateTime
  exitNotes     String?
  isDraft       Boolean         @default(true)
  completedAt   DateTime?
  completedById String?
  completedByEmail String?

  // Clearance checklist — each item records who ticked it and when
  assetReturnDone       Boolean   @default(false)
  assetReturnDoneById   String?
  assetReturnDoneByEmail String?
  assetReturnDoneAt     DateTime?

  hrClearanceDone       Boolean   @default(false)
  hrClearanceDoneById   String?
  hrClearanceDoneByEmail String?
  hrClearanceDoneAt     DateTime?

  financeClearanceDone  Boolean   @default(false)
  financeClearanceDoneById String?
  financeClearanceDoneByEmail String?
  financeClearanceDoneAt DateTime?

  managerApprovalDone   Boolean   @default(false)
  managerApprovalDoneById String?
  managerApprovalDoneByEmail String?
  managerApprovalDoneAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

// ── Employee Document ─────────────────────────────────────────────────────

model EmployeeDocument {
  id           String       @id @default(uuid())
  tenantId     String
  employeeId   String
  type         DocumentType
  name         String
  url          String
  uploadedBy   String
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

// ── Allowance ─────────────────────────────────────────────────────────────

model EmployeeAllowance {
  id           String        @id @default(uuid())
  tenantId     String
  employeeId   String
  type         AllowanceType
  name         String
  amount       Decimal       @db.Decimal(15, 2)
  isRecurring  Boolean       @default(true)
  effectiveFrom DateTime
  effectiveTo  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

// ── Leave ─────────────────────────────────────────────────────────────────

model LeaveType {
  id               String           @id @default(uuid())
  tenantId         String
  name             String
  daysAllowed      Int
  isCarryOver      Boolean          @default(false)
  maxCarryOverDays Int?
  requiresApproval Boolean          @default(true)
  isPaid           Boolean          @default(true)
  isActive         Boolean          @default(true)
  isDefault        Boolean          @default(false)
  applicableTo     EmploymentType[] @default([])
  applicableGenders Gender[]        @default([])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  balances         LeaveBalance[]
  requests         LeaveRequest[]

  @@unique([tenantId, name])
  @@schema("hr")
}

model LeaveBalance {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String
  leaveTypeId  String
  year         Int
  totalDays    Int
  usedDays     Int       @default(0)
  pendingDays  Int       @default(0)
  remainingDays Int

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@schema("hr")
}

model LeaveRequest {
  id           String             @id @default(uuid())
  tenantId     String
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  totalDays    Int
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  rejectionNote String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id])

  @@schema("hr")
}

// ── Time Management ───────────────────────────────────────────────────────

/// Manual SQL migration adds a partial unique index so only one open
/// clock record can exist per employee per day.
model ClockRecord {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  clockIn     DateTime
  clockOut    DateTime?
  date        DateTime
  hoursWorked Decimal?  @db.Decimal(5, 2)
  isLate      Boolean   @default(false)
  isOutsideSchedule Boolean @default(false)
  workMode    WorkMode?
  ipAddress   String?
  location    String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

model Timesheet {
  id           String   @id @default(uuid())
  tenantId     String
  employeeId   String
  weekStart    DateTime
  weekEnd      DateTime
  totalHours   Decimal  @db.Decimal(6, 2)
  regularHours Decimal  @db.Decimal(6, 2)
  overtimeHours Decimal @db.Decimal(6, 2) @default(0)
  isApproved   Boolean  @default(false)
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekStart])
  @@schema("hr")
}

model TimeCorrection {
  id            String               @id @default(uuid())
  tenantId      String
  employeeId    String
  date          DateTime
  originalIn    DateTime?
  originalOut   DateTime?
  requestedIn   DateTime?
  requestedOut  DateTime?
  reason        String
  status        TimeCorrectionStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

model ShiftSchedule {
  id          String    @id @default(uuid())
  tenantId    String
  employeeId  String
  shiftType   ShiftType
  workMode    WorkMode  @default(ONSITE)
  startTime   String
  endTime     String
  dayOfWeek   Int[]
  effectiveFrom DateTime
  effectiveTo DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedShiftSwaps ShiftSwapRequest[] @relation("SwapRequesterSchedule")
  targetShiftSwaps    ShiftSwapRequest[] @relation("SwapTargetSchedule")
  assignmentOverrides ShiftAssignmentOverride[]

  @@schema("hr")
}

model ShiftSwapRequest {
  id                    String          @id @default(uuid())
  tenantId              String
  requesterEmployeeId   String
  requesterScheduleId   String
  requesterShiftDate    DateTime
  targetEmployeeId      String
  targetScheduleId      String
  targetShiftDate       DateTime
  managerEmployeeId     String?
  reason                String?
  status                ShiftSwapStatus @default(PENDING_COLLEAGUE)
  expiresAt             DateTime
  colleagueRespondedAt  DateTime?
  managerDecisionAt     DateTime?
  managerRejectionReason String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  requesterEmployee Employee      @relation("ShiftSwapRequester", fields: [requesterEmployeeId], references: [id], onDelete: Cascade)
  requesterSchedule ShiftSchedule @relation("SwapRequesterSchedule", fields: [requesterScheduleId], references: [id], onDelete: Cascade)
  targetEmployee    Employee      @relation("ShiftSwapTarget", fields: [targetEmployeeId], references: [id], onDelete: Cascade)
  targetSchedule    ShiftSchedule @relation("SwapTargetSchedule", fields: [targetScheduleId], references: [id], onDelete: Cascade)
  managerEmployee   Employee?     @relation("ShiftSwapManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  overrides         ShiftAssignmentOverride[]
  actionLogs        ShiftSwapActionLog[]

  @@index([tenantId, requesterEmployeeId])
  @@index([tenantId, targetEmployeeId])
  @@index([tenantId, managerEmployeeId, status])
  @@schema("hr")
}

model ShiftSwapActionLog {
  id                 String             @id @default(uuid())
  tenantId           String
  shiftSwapRequestId String
  action             ShiftSwapActionType
  actorEmployeeId    String?
  actorUserId        String?
  note               String?
  createdAt          DateTime           @default(now())

  shiftSwapRequest   ShiftSwapRequest   @relation(fields: [shiftSwapRequestId], references: [id], onDelete: Cascade)
  actorEmployee      Employee?          @relation(fields: [actorEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, shiftSwapRequestId, createdAt])
  @@schema("hr")
}

model ShiftAssignmentOverride {
  id                String   @id @default(uuid())
  tenantId          String
  scheduleId        String
  shiftDate         DateTime
  assignedEmployeeId String
  swapRequestId     String?
  createdAt         DateTime @default(now())

  schedule          ShiftSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignedEmployee  Employee          @relation(fields: [assignedEmployeeId], references: [id], onDelete: Cascade)
  swapRequest       ShiftSwapRequest? @relation(fields: [swapRequestId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, shiftDate])
  @@index([tenantId, assignedEmployeeId, shiftDate])
  @@schema("hr")
}

// ── Payroll ───────────────────────────────────────────────────────────────

model PayrollRun {
  id           String        @id @default(uuid())
  tenantId     String
  month        Int
  year         Int
  status       PayrollStatus @default(DRAFT)
  totalGross   Decimal       @db.Decimal(15, 2)
  totalNet     Decimal       @db.Decimal(15, 2)
  totalSSNIT   Decimal       @db.Decimal(15, 2)
  totalTier3   Decimal       @db.Decimal(15, 2) @default(0)
  totalPAYE    Decimal       @db.Decimal(15, 2)
  runBy        String
  submittedBy  String?
  submittedAt  DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  paidAt       DateTime?
  notes        String?
  tier3Enabled Boolean       @default(false)
  tier3Rate    Decimal?      @db.Decimal(5, 2)
  tier3SchemeName String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items        PayrollItem[]

  @@unique([tenantId, month, year])
  @@schema("hr")
}

model PayrollItem {
  id              String     @id @default(uuid())
  tenantId        String
  payrollRunId    String
  employeeId      String
  basicSalary     Decimal    @db.Decimal(15, 2)
  totalAllowances Decimal    @db.Decimal(15, 2) @default(0)
  transportAmount Decimal    @db.Decimal(15, 2) @default(0)
  otherDeductions Decimal    @db.Decimal(15, 2) @default(0)
  overtimePay     Decimal    @db.Decimal(15, 2) @default(0)
  bonus           Decimal    @db.Decimal(15, 2) @default(0)
  thirteenthMonth Decimal    @db.Decimal(15, 2) @default(0)
  grossSalary     Decimal    @db.Decimal(15, 2)
  employeeSSNIT   Decimal    @db.Decimal(15, 2)
  employerSSNIT   Decimal    @db.Decimal(15, 2)
  tier3Employee   Decimal    @db.Decimal(15, 2) @default(0)
  taxableIncome   Decimal    @db.Decimal(15, 2) @default(0)
  payeTax         Decimal    @db.Decimal(15, 2)
  totalDeductions Decimal    @db.Decimal(15, 2)
  netSalary       Decimal    @db.Decimal(15, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@schema("hr")
}

// ── Appraisal ─────────────────────────────────────────────────────────────

model AppraisalTemplate {
  id                      String   @id @default(uuid())
  tenantId                String
  name                    String
  selfAssessmentWeight    Int      @default(40)
  managerAssessmentWeight Int      @default(60)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  kpis   AppraisalTemplateKpi[]
  cycles AppraisalCycle[]

  @@unique([tenantId, name])
  @@schema("hr")
}

model AppraisalTemplateKpi {
  id          String            @id @default(uuid())
  templateId  String
  title       String
  weight      Int
  maxScore    Int               @default(5)
  description String?
  createdAt   DateTime          @default(now())

  template    AppraisalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@schema("hr")
}

model AppraisalCycle {
  id                      String    @id @default(uuid())
  tenantId                String
  title                   String
  description             String?
  startDate               DateTime
  endDate                 DateTime
  selfAssessmentDeadline  DateTime?
  managerReviewDeadline   DateTime?
  frequency               String?
  departmentIds           String[]  @default([])
  employmentTypes         String[]  @default([])
  employmentStatuses      EmploymentStatus[] @default([])
  employeeIds             String[]  @default([])
  templateId              String?
  selfAssessmentWeight    Int       @default(40)
  managerAssessmentWeight Int       @default(60)
  status                  AppraisalCycleStatus @default(UPCOMING)
  isActive                Boolean   @default(false)
  activatedAt             DateTime?
  cancelledAt             DateTime?
  cancelledReason         String?
  createdBy               String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  appraisals  Appraisal[]
  kpis        AppraisalKpi[]
  template    AppraisalTemplate? @relation(fields: [templateId], references: [id])

  @@unique([tenantId, title])
  @@schema("hr")
}

model AppraisalKpi {
  id            String         @id @default(uuid())
  tenantId      String
  cycleId       String
  title         String
  description   String?
  weight        Int
  maxScore      Int            @default(5)
  selfWeight    Int            @default(50)
  managerWeight Int            @default(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cycle         AppraisalCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  scores        AppraisalKpiScore[]

  @@schema("hr")
}

model Appraisal {
  id          String          @id @default(uuid())
  tenantId    String
  cycleId     String
  employeeId  String
  managerId   String?
  status      AppraisalStatus @default(DRAFT)

  selfScore   Float?
  selfComment String?
  selfStatus  ReviewStatus    @default(PENDING)
  selfSubmittedAt DateTime?

  managerScore   Float?
  managerComment String?
  managerStatus  ReviewStatus @default(PENDING)
  managerSubmittedAt DateTime?

  finalScore  Float?
  finalComment String?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  cycle       AppraisalCycle     @relation(fields: [cycleId], references: [id])
  employee    Employee           @relation("AppraisalEmployee", fields: [employeeId], references: [id])
  manager     Employee?          @relation("AppraisalManager", fields: [managerId], references: [id])
  kpiScores   AppraisalKpiScore[]
  reminderLogs AppraisalReminderLog[]

  @@unique([cycleId, employeeId])
  @@schema("hr")
}

model AppraisalKpiScore {
  id          String       @id @default(uuid())
  tenantId    String
  appraisalId String
  kpiId       String
  reviewType  String
  score       Int
  comment     String?
  createdAt   DateTime     @default(now())

  appraisal   Appraisal    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpi         AppraisalKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, kpiId, reviewType])
  @@schema("hr")
}

model AppraisalReminderLog {
  id           String               @id @default(uuid())
  tenantId     String
  appraisalId  String
  reminderType AppraisalReminderType
  createdAt    DateTime             @default(now())

  appraisal    Appraisal            @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, reminderType])
  @@schema("hr")
}

model Announcement {
  id                  String                   @id @default(uuid())
  tenantId            String
  title               String
  body                String
  audienceType        AnnouncementAudienceType @default(ALL)
  targetDepartmentIds String[]                 @default([])
  targetBranchIds     String[]                 @default([])
  targetEmployeeIds   String[]                 @default([])
  sendEmail           Boolean                  @default(false)
  publishedAt         DateTime                 @default(now())
  expiresAt           DateTime?
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([tenantId, publishedAt])
  @@index([tenantId, expiresAt])
  @@index([tenantId, audienceType])

  @@schema("hr")
}

model EmployeeInviteRollbackTask {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  email         String
  attemptCount  Int      @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@schema("hr")
}

model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String
  message    String
  link       String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
  @@index([tenantId, userId])
  @@schema("hr")
}

model PublicHoliday {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@schema("hr")
}

model TenantConfig {
  id                          String   @id @default(uuid())
  tenantId                    String   @unique
  adminEmail                  String
  adminUserId                 String?
  defaultProbationPeriodMonths Int?
  resignationNoticePeriodDays Int      @default(30)
  lateArrivalThresholdMinutes Int      @default(0)
  payrollTier3Enabled         Boolean  @default(false)
  payrollTier3Rate            Decimal? @db.Decimal(5, 2)
  payrollTier3SchemeName      String?
  appraisalCycleRecipients    AppraisalCycleRecipientGroup[] @default([ALL])
  appraisalEligibleStatuses   EmploymentStatus[] @default([ACTIVE, PROBATION])
  outstandingThreshold        Int      @default(90)
  veryGoodThreshold           Int      @default(80)
  goodThreshold               Int      @default(70)
  satisfactoryThreshold       Int      @default(60)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@schema("hr")
}

model CompanyAgreement {
  id        String               @id @default(uuid())
  tenantId  String
  type      CompanyAgreementType
  title     String
  details   String
  createdBy String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId, createdAt])
  @@schema("hr")
}
