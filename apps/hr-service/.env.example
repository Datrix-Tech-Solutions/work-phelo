DATABASE_URL=postgresql://erp:erppassword@localhost:5432/workphelo?schema=hr
RABBITMQ_URL=amqps://user:password@shark.rmq.cloudamqp.com/vhost
REDIS_URL=redis://localhost:6379
FRONTEND_BASE_URL=http://localhost:3000

# Field-level encryption (Phase 1)
# Generate each key:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both vars are required — the service will throw on startup if either is missing or malformed.
FIELD_ENCRYPTION_KEY=
FIELD_HMAC_KEY=

# Internal service-to-service calls into accounting-service, through @work-phelo/internal-auth:
# asking whether payroll is linked when a run is approved, and posting its accrual journal. Same
# INTERNAL_SERVICE_AUTH_SECRET must be set on accounting-service too, which must also add
# "hr-service" to its INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES list. Leave ACCOUNTING_SERVICE_URL
# unset on a deployment with no accounting-service and payroll simply runs on its own.
ACCOUNTING_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_AUTH_SECRET=
ACCOUNTING_SERVICE_TIMEOUT_MS=10000

# Inbound internal calls (guarded by @work-phelo/internal-auth). Callers must be listed here,
# e.g. marketing-service for the fleet module's vehicle-asset routes under /internal/fleet-assets,
# and accounting-service for the payroll settlement callbacks under /internal/payroll-settlement.
# The same INTERNAL_SERVICE_AUTH_SECRET must be set on every calling service.
INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES=marketing-service,accounting-service
