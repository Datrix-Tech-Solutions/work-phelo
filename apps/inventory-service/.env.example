# Required: use the same local verification secret as Auth and Gateway.
JWT_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/workphelo?schema=inventory
INVENTORY_SERVICE_PORT=4009
NODE_ENV=development
ENABLE_SWAGGER=true
HTTP_BODY_LIMIT=1mb
# RabbitMQ/Redis credentials are not required.
# Recording supplier payments in Accounting. Accounting must list "inventory-service" in its
# INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES, and this service must list "accounting-service" in its own.
# INTERNAL_SERVICE_AUTH_SECRET (32+ chars) must match accounting-service.
ACCOUNTING_SERVICE_URL=http://localhost:4008
ACCOUNTING_SERVICE_TIMEOUT_MS=10000
INTERNAL_SERVICE_AUTH_SECRET=
INTERNAL_SERVICE_AUTH_ALLOWED_SERVICES=accounting-service
