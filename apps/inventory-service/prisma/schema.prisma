generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["inventory"]
}

enum StockLocationType {
  WAREHOUSE
  STORE
  BRANCH
  OFFICE_STORE
  OTHER

  @@schema("inventory")
}

enum InventoryConfigurationStatus {
  ACTIVE
  INACTIVE

  @@schema("inventory")
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE

  @@schema("inventory")
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE

  @@schema("inventory")
}

enum PartyKind {
  CUSTOMER
  SUPPLIER

  @@schema("inventory")
}

enum StockOutPurpose {
  INTERNAL_USE
  SALE
  CONSUMPTION
  PROJECT_USE
  EMPLOYEE_ISSUE
  DAMAGE
  OTHER

  @@schema("inventory")
}

model InventoryCategory {
  id            String                       @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  icon          String?
  status        InventoryConfigurationStatus @default(ACTIVE)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  items         InventoryItem[]
  subcategories InventorySubcategory[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model UnitOfMeasure {
  id          String                       @id @default(uuid())
  tenantId    String
  name        String
  symbol      String
  description String?
  status      InventoryConfigurationStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  items       InventoryItem[]
  movements   StockMovement[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model StockLocation {
  id              String                       @id @default(uuid())
  tenantId        String
  name            String
  code            String
  address         String?
  status          InventoryConfigurationStatus @default(ACTIVE)
  type            StockLocationType
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  balances        StockBalance[]
  movements       StockMovement[]
  lots            StockLot[]
  variantBalances VariantBalance[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model InventoryItem {
  id              String                @id @default(uuid())
  tenantId        String
  name            String
  sku             String
  categoryId      String
  subcategoryId   String?
  unitOfMeasureId String
  description     String?
  costPrice       Decimal?              @db.Decimal(18, 4)
  sellingPrice    Decimal?              @db.Decimal(18, 4)
  reorderLevel    Decimal?              @db.Decimal(18, 4)
  isPerishable    Boolean               @default(false)
  status          InventoryItemStatus   @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  category        InventoryCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  subcategory     InventorySubcategory? @relation(fields: [tenantId, subcategoryId], references: [tenantId, id], onDelete: Restrict)
  unitOfMeasure   UnitOfMeasure         @relation(fields: [tenantId, unitOfMeasureId], references: [tenantId, id], onDelete: Restrict)
  balances        StockBalance[]
  movements       StockMovement[]
  variants        ItemVariant[]
  variantBalances VariantBalance[]
  lots            StockLot[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
  @@index([tenantId, subcategoryId])
  @@index([tenantId, unitOfMeasureId])
  @@schema("inventory")
}

model StockBalance {
  id         String        @id @default(uuid())
  tenantId   String
  itemId     String
  locationId String
  quantity   Decimal       @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  item       InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location   StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, itemId, locationId])
  @@index([tenantId, locationId])
  @@schema("inventory")
}

model StockMovement {
  id               String            @id @default(uuid())
  tenantId         String
  itemId           String
  locationId       String
  unitOfMeasureId  String
  type             StockMovementType @default(STOCK_IN)
  quantity         Decimal           @db.Decimal(18, 4)
  unitCost         Decimal?          @db.Decimal(18, 4)
  totalCost        Decimal?          @db.Decimal(36, 8)
  date             DateTime
  source           String?
  supplier         String?
  reference        String?
  notes            String?
  recipient        String?
  purpose          StockOutPurpose?
  transferId       String?
  batchId          String?
  adjustmentReason String?
  variantId        String?
  lotNumber        String?
  manufactureDate  DateTime?         @db.Date
  expiryDate       DateTime?         @db.Date
  lotId            String?
  createdBy        String
  createdAt        DateTime          @default(now())
  item             InventoryItem     @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  variant          ItemVariant?      @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  lot              StockLot?         @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  location         StockLocation     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  unitOfMeasure    UnitOfMeasure     @relation(fields: [tenantId, unitOfMeasureId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, itemId])
  @@index([tenantId, locationId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, transferId])
  @@index([tenantId, batchId])
  @@index([tenantId, variantId])
  @@index([tenantId, itemId, lotNumber])
  @@index([tenantId, lotId])
  @@schema("inventory")
}

model InventoryParty {
  id            String                       @id @default(uuid())
  tenantId      String
  kind          PartyKind
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        InventoryConfigurationStatus @default(ACTIVE)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([tenantId, kind, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model InventorySubcategory {
  id         String                       @id @default(uuid())
  tenantId   String
  categoryId String
  name       String
  status     InventoryConfigurationStatus @default(ACTIVE)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  category   InventoryCategory            @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  items      InventoryItem[]

  @@unique([tenantId, categoryId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model ItemVariant {
  id        String                       @id @default(uuid())
  tenantId  String
  itemId    String
  name      String
  status    InventoryConfigurationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  item      InventoryItem                @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  balances  VariantBalance[]
  movements StockMovement[]
  lots      StockLot[]

  @@unique([tenantId, itemId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

// Stock of one variant at one location. StockBalance stays the item's total there; this splits
// the part of it that was received, moved or adjusted under a variant.
model VariantBalance {
  id         String        @id @default(uuid())
  tenantId   String
  itemId     String
  locationId String
  variantId  String
  quantity   Decimal       @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  item       InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location   StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  variant    ItemVariant   @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, itemId, locationId, variantId])
  @@index([tenantId, locationId])
  @@index([tenantId, variantId])
  @@schema("inventory")
}

// Reasons offered for stock adjustments. The six built-in ones are created for a company the first
// time its reasons are used; companies add their own. A movement stores the reason's code.
model AdjustmentReason {
  id        String                       @id @default(uuid())
  tenantId  String
  code      String
  name      String
  isSystem  Boolean                      @default(false)
  status    InventoryConfigurationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@schema("inventory")
}

// A batch/lot received by a stock in line that names a batch number or an expiry date. Stock in
// sets remainingQuantity to what was received; stock out draws it down.
model StockLot {
  id                String          @id @default(uuid())
  tenantId          String
  itemId            String
  locationId        String
  variantId         String?
  lotNumber         String?
  manufactureDate   DateTime?       @db.Date
  expiryDate        DateTime?       @db.Date
  receivedQuantity  Decimal         @db.Decimal(18, 4)
  remainingQuantity Decimal         @db.Decimal(18, 4)
  createdAt         DateTime        @default(now())
  item              InventoryItem   @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location          StockLocation   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  variant           ItemVariant?    @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  movements         StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, itemId, locationId])
  @@index([tenantId, locationId])
  @@index([tenantId, variantId])
  @@schema("inventory")
}
