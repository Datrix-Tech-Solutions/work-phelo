generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  output          = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["inventory"]
}

enum StockLocationType {
  WAREHOUSE
  STORE
  BRANCH
  OFFICE_STORE
  OTHER

  @@schema("inventory")
}

enum InventoryConfigurationStatus {
  ACTIVE
  INACTIVE

  @@schema("inventory")
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE

  @@schema("inventory")
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE

  @@schema("inventory")
}

enum PartyKind {
  CUSTOMER
  SUPPLIER

  @@schema("inventory")
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
  PENDING_APPROVAL
  REJECTED
  INVOICED

  @@schema("inventory")
}

enum PurchaseInvoiceStatus {
  ACTIVE
  VOID

  @@schema("inventory")
}

// What has happened to a posted movement since. REVERSED is a label only: it changes no stock.
// CANCELLED and DELETED mean the stock was put back by another movement (the OFFSET one, which is
// hidden from lists); DELETED movements are hidden too.
enum StockMovementState {
  ACTIVE
  REVERSED
  CANCELLED
  DELETED
  OFFSET

  @@schema("inventory")
}

enum StockMovementRequestKind {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  ADJUSTMENT

  @@schema("inventory")
}

enum StockMovementRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("inventory")
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  OTHER

  @@schema("inventory")
}

enum StockOutPurpose {
  INTERNAL_USE
  SALE
  CONSUMPTION
  PROJECT_USE
  EMPLOYEE_ISSUE
  DAMAGE
  OTHER

  @@schema("inventory")
}

model InventoryCategory {
  id            String                       @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  icon          String?
  status        InventoryConfigurationStatus @default(ACTIVE)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  items         InventoryItem[]
  subcategories InventorySubcategory[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model UnitOfMeasure {
  id          String                       @id @default(uuid())
  tenantId    String
  name        String
  symbol      String
  description String?
  status      InventoryConfigurationStatus @default(ACTIVE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  items       InventoryItem[]
  movements   StockMovement[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model StockLocation {
  id              String                       @id @default(uuid())
  tenantId        String
  name            String
  code            String
  address         String?
  status          InventoryConfigurationStatus @default(ACTIVE)
  type            StockLocationType
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  balances        StockBalance[]
  movements       StockMovement[]
  lots            StockLot[]
  variantBalances VariantBalance[]
  purchaseOrders  PurchaseOrder[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model InventoryItem {
  id                 String                @id @default(uuid())
  tenantId           String
  name               String
  sku                String
  categoryId         String
  subcategoryId      String?
  unitOfMeasureId    String
  description        String?
  costPrice          Decimal?              @db.Decimal(18, 4)
  sellingPrice       Decimal?              @db.Decimal(18, 4)
  reorderLevel       Decimal?              @db.Decimal(18, 4)
  maxStock           Decimal?              @db.Decimal(18, 4)
  isPerishable       Boolean               @default(false)
  status             InventoryItemStatus   @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  category           InventoryCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  subcategory        InventorySubcategory? @relation(fields: [tenantId, subcategoryId], references: [tenantId, id], onDelete: Restrict)
  unitOfMeasure      UnitOfMeasure         @relation(fields: [tenantId, unitOfMeasureId], references: [tenantId, id], onDelete: Restrict)
  balances           StockBalance[]
  movements          StockMovement[]
  variants           ItemVariant[]
  variantBalances    VariantBalance[]
  lots               StockLot[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
  @@index([tenantId, subcategoryId])
  @@index([tenantId, unitOfMeasureId])
  @@schema("inventory")
}

model StockBalance {
  id         String        @id @default(uuid())
  tenantId   String
  itemId     String
  locationId String
  quantity   Decimal       @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  item       InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location   StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, itemId, locationId])
  @@index([tenantId, locationId])
  @@schema("inventory")
}

model StockMovement {
  id                  String             @id @default(uuid())
  tenantId            String
  itemId              String
  locationId          String
  unitOfMeasureId     String
  type                StockMovementType  @default(STOCK_IN)
  quantity            Decimal            @db.Decimal(18, 4)
  unitCost            Decimal?           @db.Decimal(18, 4)
  totalCost           Decimal?           @db.Decimal(36, 8)
  date                DateTime
  source              String?
  supplier            String?
  reference           String?
  notes               String?
  recipient           String?
  purpose             StockOutPurpose?
  transferId          String?
  batchId             String?
  adjustmentReason    String?
  variantId           String?
  lotNumber           String?
  manufactureDate     DateTime?          @db.Date
  expiryDate          DateTime?          @db.Date
  lotId               String?
  purchaseOrderLineId String?
  createdBy           String
  // Who approved the request this movement was posted from; null for movements posted directly.
  approvedBy          String?
  state               StockMovementState @default(ACTIVE)
  stateChangedBy      String?
  stateChangedAt      DateTime?
  createdAt           DateTime           @default(now())
  item                InventoryItem      @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  variant             ItemVariant?       @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  lot                 StockLot?          @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)
  location            StockLocation      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  unitOfMeasure       UnitOfMeasure      @relation(fields: [tenantId, unitOfMeasureId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  @@index([tenantId, itemId])
  @@index([tenantId, locationId])
  @@index([tenantId, unitOfMeasureId])
  @@index([tenantId, transferId])
  @@index([tenantId, batchId])
  @@index([tenantId, variantId])
  @@index([tenantId, itemId, lotNumber])
  @@index([tenantId, lotId])
  @@index([tenantId, purchaseOrderLineId])
  @@schema("inventory")
}

model InventoryParty {
  id             String                       @id @default(uuid())
  tenantId       String
  kind           PartyKind
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  status         InventoryConfigurationStatus @default(ACTIVE)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@unique([tenantId, kind, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model InventorySubcategory {
  id         String                       @id @default(uuid())
  tenantId   String
  categoryId String
  name       String
  status     InventoryConfigurationStatus @default(ACTIVE)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  category   InventoryCategory            @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  items      InventoryItem[]

  @@unique([tenantId, categoryId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

model ItemVariant {
  id        String                       @id @default(uuid())
  tenantId  String
  itemId    String
  name      String
  status    InventoryConfigurationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  item      InventoryItem                @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  balances  VariantBalance[]
  movements StockMovement[]
  lots      StockLot[]

  @@unique([tenantId, itemId, name])
  @@unique([tenantId, id])
  @@schema("inventory")
}

// Stock of one variant at one location. StockBalance stays the item's total there; this splits
// the part of it that was received, moved or adjusted under a variant.
model VariantBalance {
  id         String        @id @default(uuid())
  tenantId   String
  itemId     String
  locationId String
  variantId  String
  quantity   Decimal       @db.Decimal(18, 4)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  item       InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location   StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  variant    ItemVariant   @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, itemId, locationId, variantId])
  @@index([tenantId, locationId])
  @@index([tenantId, variantId])
  @@schema("inventory")
}

// Reasons offered for stock adjustments. The six built-in ones are created for a company the first
// time its reasons are used; companies add their own. A movement stores the reason's code.
model AdjustmentReason {
  id        String                       @id @default(uuid())
  tenantId  String
  code      String
  name      String
  isSystem  Boolean                      @default(false)
  status    InventoryConfigurationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@schema("inventory")
}

// A batch/lot received by a stock in line that names a batch number or an expiry date. Stock in
// sets remainingQuantity to what was received; stock out draws it down.
model StockLot {
  id                String          @id @default(uuid())
  tenantId          String
  itemId            String
  locationId        String
  variantId         String?
  lotNumber         String?
  manufactureDate   DateTime?       @db.Date
  expiryDate        DateTime?       @db.Date
  receivedQuantity  Decimal         @db.Decimal(18, 4)
  remainingQuantity Decimal         @db.Decimal(18, 4)
  createdAt         DateTime        @default(now())
  item              InventoryItem   @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location          StockLocation   @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  variant           ItemVariant?    @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  movements         StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, itemId, locationId])
  @@index([tenantId, locationId])
  @@index([tenantId, variantId])
  @@schema("inventory")
}

// An order placed with a supplier. Nothing is in stock until it is received: each receipt posts a
// stock in (StockMovement rows pointing at the order line) for the warehouse named here.
model PurchaseOrder {
  id              String                 @id @default(uuid())
  tenantId        String
  reference       String
  orderDate       DateTime               @db.Date
  expectedDate    DateTime?              @db.Date
  supplierId      String
  locationId      String
  paymentTerms    String?
  notes           String?
  status          PurchaseOrderStatus    @default(ORDERED)
  createdBy       String
  // Orders placed before approvals existed have no approver.
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  supplier        InventoryParty         @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  location        StockLocation          @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  lines           PurchaseOrderLine[]
  payments        PurchaseOrderPayment[]
  invoices        PurchaseInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, reference])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, supplierId])
  @@index([tenantId, locationId])
  @@schema("inventory")
}

// receivedQuantity counts the units ordered that have arrived and is what the supplier is paid
// for. extraQuantity is free stock on top (a bonus): it is stocked and valued at the unit cost but
// not paid for.
model PurchaseOrderLine {
  id               String                @id @default(uuid())
  tenantId         String
  purchaseOrderId  String
  itemId           String
  variantName      String?
  orderedQuantity  Decimal               @db.Decimal(18, 4)
  // The price comes from the supplier's invoices, not the order: the average unit cost invoiced so
  // far (null until the line is invoiced). Goods are received at it.
  unitCost         Decimal?              @db.Decimal(18, 4)
  invoicedQuantity Decimal               @default(0) @db.Decimal(18, 4)
  invoicedValue    Decimal               @default(0) @db.Decimal(18, 4)
  // The units received, at the unit cost: what has been delivered of what was invoiced.
  receivedValue    Decimal               @default(0) @db.Decimal(18, 4)
  receivedQuantity Decimal               @default(0) @db.Decimal(18, 4)
  extraQuantity    Decimal               @default(0) @db.Decimal(18, 4)
  // Units that arrived damaged: not stocked, and not counted as received.
  damagedQuantity  Decimal               @default(0) @db.Decimal(18, 4)
  purchaseOrder    PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  item             InventoryItem         @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  movements        StockMovement[]
  invoiceLines     PurchaseInvoiceLine[]

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, itemId])
  @@schema("inventory")
}

// Money paid to a supplier. One payment can settle several orders: each order's share is a
// PurchaseOrderPayment, and an order's amount paid is the sum of its shares.
model SupplierPayment {
  id          String                 @id @default(uuid())
  tenantId    String
  supplierId  String
  reference   String?
  paymentDate DateTime               @db.Date
  method      SupplierPaymentMethod
  amount      Decimal                @db.Decimal(18, 4)
  notes       String?
  createdBy   String
  createdAt   DateTime               @default(now())
  supplier    InventoryParty         @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  allocations PurchaseOrderPayment[]

  @@unique([tenantId, id])
  @@index([tenantId, supplierId])
  @@schema("inventory")
}

model PurchaseOrderPayment {
  id              String          @id @default(uuid())
  tenantId        String
  paymentId       String
  purchaseOrderId String
  amount          Decimal         @db.Decimal(18, 4)
  payment         SupplierPayment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder   @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId, purchaseOrderId])
  @@index([tenantId, purchaseOrderId])
  @@schema("inventory")
}

// A stock movement waiting for approval. The movement is described by the same body the batch
// endpoints take (payload); stock only changes when the request is approved and that body is
// applied, so a pending or rejected request never touches balances.
model StockMovementRequest {
  id              String                     @id @default(uuid())
  tenantId        String
  kind            StockMovementRequestKind
  reference       String?
  payload         Json
  status          StockMovementRequestStatus @default(PENDING)
  createdBy       String
  createdAt       DateTime                   @default(now())
  decidedBy       String?
  decidedAt       DateTime?
  rejectionReason String?
  // The batchId of the movement rows posted on approval.
  batchId         String?

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@schema("inventory")
}

// The supplier's bill for (part of) an order: it says how many units are charged and at what unit
// cost, which sets what is owed. It changes no stock; receiving does that.
model PurchaseInvoice {
  id              String                @id @default(uuid())
  tenantId        String
  purchaseOrderId String
  number          String
  invoiceDate     DateTime              @db.Date
  dueDate         DateTime?             @db.Date
  notes           String?
  status          PurchaseInvoiceStatus @default(ACTIVE)
  createdBy       String
  createdAt       DateTime              @default(now())
  purchaseOrder   PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  lines           PurchaseInvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, purchaseOrderId, number])
  @@index([tenantId, purchaseOrderId])
  @@schema("inventory")
}

model PurchaseInvoiceLine {
  id                  String            @id @default(uuid())
  tenantId            String
  invoiceId           String
  purchaseOrderLineId String
  quantity            Decimal           @db.Decimal(18, 4)
  unitCost            Decimal           @db.Decimal(18, 4)
  invoice             PurchaseInvoice   @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, invoiceId])
  @@index([tenantId, purchaseOrderLineId])
  @@schema("inventory")
}
